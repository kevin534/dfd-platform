# ============================================================
#  DFD — Configuration du serveur
#  Copiez ce fichier en ".env" et remplissez les valeurs.
# ============================================================

# Port du serveur API
PORT=4000

# Origine autorisée pour le frontend (CORS). En prod, mettez l'URL du site.
CLIENT_ORIGIN=http://localhost:5173

# Secret pour signer les jetons de connexion admin (CHANGEZ-LE en production !)
JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire

# Compte administrateur initial (créé au premier démarrage)
ADMIN_EMAIL=admin@dfd.org
ADMIN_PASSWORD=DfdAdmin2025!

# ------------------------------------------------------------
#  PAIEMENTS
#  Chaque moyen de paiement passe en mode LIVE indépendamment,
#  dès que SES PROPRES clés ci-dessous sont renseignées. Pas de
#  clés pour un moyen -> il reste simulé, même si d'autres sont live.
#  PAYMENTS_MODE=demo est un coupe-circuit global : force le mode
#  démo PARTOUT quelles que soient les clés présentes. Laissez-le
#  vide/absent pour laisser chaque moyen décider seul.
# ------------------------------------------------------------
PAYMENTS_MODE=               # (vide) | demo

# --- Orange Money (Web Payment API) ---
# Obtenu sur https://developer.orange.com (compte marchand requis)
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_MERCHANT_KEY=
ORANGE_RETURN_URL=http://localhost:5173/don/retour
ORANGE_CANCEL_URL=http://localhost:5173/don

# --- MTN Mobile Money (Collection API) ---
# Obtenu sur https://momodeveloper.mtn.com (compte marchand requis)
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_TARGET_ENV=sandbox      # sandbox | mtncameroon | ...

# --- Stripe (carte bancaire / SEPA pour l'Europe) ---
# Obtenu sur https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayPal (Orders API v2) ---
# Obtenu sur https://developer.paypal.com/dashboard (compte Business requis)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live            # live | sandbox (test)

# URL publique de CE serveur (utilisée pour les retours PayPal après paiement)
PUBLIC_API_URL=http://localhost:4000

# ------------------------------------------------------------
#  ANTI-SPAM
#  Sans clé, les formulaires publics tournent en mode démo
#  (vérification anti-robot toujours acceptée).
# ------------------------------------------------------------
# Obtenu sur https://www.google.com/recaptcha/admin (reCAPTCHA v2)
RECAPTCHA_SECRET_KEY=

# ------------------------------------------------------------
#  E-MAIL (notification du formulaire de contact)
#  Sans SMTP_HOST, aucun e-mail n'est envoyé (mode démo).
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CONTACT_NOTIFY_EMAIL=kevinxavier.toukam@gmail.com
